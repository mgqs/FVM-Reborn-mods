// obj_mianbao（融合菠萝面包）Create 事件
// 三形态：0 火炉菠萝面包 / 1 火龙果菠萝包 / 2 机枪菠萝面包
// 前置主卡：皇冠菠萝面包（pineapple_explosive_bread 2 转），融合配方见 scripts/mod_craft_fusion_table
// 数值全部取自「基本信息.xlsx / 卡片信息」第 1~12 行（16 级；0 级产火 = 0、灼烧与子弹是「/」→ 这三项都不做）
//
// 机制（三档叠加，下层能力全保留）：
//   ① 阻挡：plant_type normal，老鼠停下啃它；**只有 hp 归零才炸**（铲除 / 云洞吞 / BOSS 清格不炸）
//      死亡 5*5 灰烬爆炸：非防爆鼠秒杀出灰烬，防爆鼠 / BOSS 吃 900（结算在 Destroy_0）
//   ② 被咬才产火（**没有自动产火**）：只在被啃咬时计秒，每满 1 秒飘 1 朵 obj_flame（值 = 每秒产火）；
//      啃咬被打断时，不足 1 秒那一段补 1 朵然后停。每产一朵火，本体播一次「产火」动画段
//   ③ 1 转起：每 4.5 秒（270 帧）一次 5*5 灼烧 —— 铺 25 个 obj_burn_cell（火焰贴片循环素材 5~12 帧），
//      存在 2 秒、5 跳（每 0.4 秒 = 24 帧一跳），每跳 = 深度灼烧伤害表
//   ④ 2 转起：每 1.5 秒（90 帧）本行水平 4 连发（每 4 帧一发），复用机枪小笼包的 obj_xiaolongbao_bullet
//      （它自带火盆过火 + 布丁/水神反弹，正好对上卡面「可过火、可被反弹」）
event_inherited();  // 继承父对象属性
plant_id = "mianbao";
obj_type = object_index;
current_level = 1
event_user(0)
if shape == 0{
	sprite_index = spr_mianbao
}
else if shape == 1{
	sprite_index = spr_mianbao_1
}
else{
	sprite_index = spr_mianbao_2
}

// ========== 动画分段（逐帧量出来的，0 基索引）==========
// 每套素材都是「三档受损 × (待机 + 产火) + 末尾爆炸」，待机段首尾同图 → 实际循环 12 帧：
//   0 转 101 帧：待机 0/29/58 起（各 13 帧，1-13 / 30-42 / 59-71）
//                产火高光帧 = 帧 27 / 56 / 85（index 26 / 55 / 84），从这一帧起播 3 帧（27-29 / 56-58 / 85-87）
//                爆炸 87~100（帧 88-101）
//   1 转  92 帧：待机 0/26/52 起；产火高光帧 = 帧 23 / 49 / 75（index 22 / 48 / 74），播 4 帧（23-26 …）
//                爆炸 78~91（帧 79-92）
//   2 转  86 帧：待机 0/24/48 起；产火段整段是机枪后坐（14-24，各 11 帧）
//                爆炸 72~85（帧 73-86）
if shape == 0{
	SEG_IDLE_FIRST = [0, 29, 58];
	SEG_FIRE_FIRST = [26, 55, 84];   // 帧 27 / 56 / 85：冒烟最高的那帧，就是产火那一帧
	SEG_FIRE_LEN   = 3;              // 27-29（余烟一起带走）
	SEG_BOOM_FIRST = 87;
}
else if shape == 1{
	SEG_IDLE_FIRST = [0, 26, 52];
	SEG_FIRE_FIRST = [22, 48, 74];   // 帧 23 / 49 / 75
	SEG_FIRE_LEN   = 4;              // 23-26
	SEG_BOOM_FIRST = 78;
}
else{
	SEG_IDLE_FIRST = [0, 24, 48];
	SEG_FIRE_FIRST = [13, 37, 61];   // 2 转这套没有冒烟帧：14-24 是**机枪后坐**，给「开火」用
	SEG_FIRE_LEN   = 0;              // 所以产火不播动画（没有冒烟帧可播）
	SEG_BOOM_FIRST = 72;
}
SEG_IDLE_LEN = 12;        // 每档待机 13 帧，末帧 = 首帧，循环 12 帧避免卡一帧

attack_anim = 0           // 没有攻击动画；帧由本对象自己推（见 Step 末段），父对象那套只用来记时
image_speed = 0           // 关掉引擎自动播放
flash_speed = 5           // 待机段（12 帧 × 5 = 60 帧 ≈ 1 秒一轮）
SEG_SHOOT_LEN = (shape == 2) ? 11 : 0   // 开火段帧数（只有 2 转有：14-24 机枪后坐）
fire_flash_speed = [8, 7, 4]   // 产火段每帧停留帧数（按形态；越大越慢）：
                                //   0 转 3 帧 ×8 = 24 帧(0.4s) / 1 转 4 帧 ×7 = 28 帧(0.47s) / 2 转 11 帧 ×4 = 44 帧(0.73s)

// 帧推进状态
anim_tier = 0             // 受损档：0 正常 / 1 受损 / 2 最残（hp 33% / 66% 分界）
idle_t = 0
fire_anim_t = -1          // 产火动画已播帧数；-1 = 没在播（播待机），>= 0 = 正在播产火段
shoot_anim_t = -1         // 开火动画已播帧数（只有 2 转用）；-1 = 没在播
shoot_flash_speed = 2     // 开火段每帧停留帧数（11 帧 × 2 = 22 帧 ≈ 0.37 秒）
shoot_beat = 0            // 本轮已经打到第几发（0~3）
// 开火帧（相对该档产火段首帧的偏移）：段首是帧 14，**第 17 帧就是开火帧 → +3**
//   机枪嘴动 4 下 = 帧 17 / 19 / 21 / 23，每一下打 1 发，正好 4 发
SHOOT_BEATS = [3, 5, 7, 9]

// ========== 数值来源 ==========
//   每秒产火 → 注册表 flame_produce（面板「火苗产量」）
//   灼烧伤害 → 注册表 cycle（面板「攻击间隔」= xlsx 深度灼烧伤害；1·2 转共用同一张表）
//   🔴 cycle 是「攻击间隔」，面板（obj_info_island_bg/Draw_0）显示时会 ÷60 → 注册表里存的是 伤害 ×60，
//      所以这里必须 ÷60 还原；以后要调灼烧伤害，改注册表那行时记得也 ×60（面板数字才不会变成 1/60）
//   子弹伤害 → 注册表 atk（面板「攻击力」= xlsx 灵魂子弹攻击力，只有 2 转有）
//   分工是硬的：**灼烧只看 cycle，子弹只看 atk**，两个字段互不影响。
//   1 转没有子弹 → atk 全 0（别再拿灼烧值镜像过去，否则面板「攻击力」和「攻击间隔」会是同一个数）
fire_table = [0, 6, 8, 10, 10, 12, 12, 14, 16, 16, 18, 18, 22, 24, 28, 30, 34];   // 仅当注册表没给 flame_produce 时兜底
var _lv = clamp(current_level, 0, 16);
flame_value   = variable_instance_exists(id, "flame_produce") ? flame_produce : fire_table[_lv];
burn_damage   = (shape >= 1) ? (origin_cycle / 60) : 0;   // ÷60：注册表存的是「伤害 ×60」；origin_cycle 避免减速时被 ×2
bullet_damage = (shape >= 2) ? atk : 0;

// ---------- ② 被咬产火 ----------
chew_timer = 0          // 被咬累计帧数（满 60 给 1 朵）
was_chewed = false

// ---------- ③ 1 转灼烧 ----------
burn_timer = 0
burn_interval = 270     // 4.5 秒一次

// ---------- ④ 2 转 4 连发 ----------
shot_timer = 0
shot_interval = 90      // 1.5 秒一轮
shots_left = 0         // 本轮还剩几发（跟着嘴动帧出膛）
