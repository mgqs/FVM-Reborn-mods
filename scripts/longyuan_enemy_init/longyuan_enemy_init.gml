function longyuan_enemy_init() {
 register_enemy("longyuan_pingmin", {name: "龙渊平民鼠", _obj: obj_ly_pingmin, hp: 200, shield: 0, description: "龙渊平民鼠：普通行走啃咬", speed: 0.32, atk: 10, cycle: 36, range: 90, ash_proof: false, spr: spr_pingmin, feature: "land"});
 register_enemy("longyuan_dijing", {name: "地精鼠", _obj: obj_ly_dijing, hp: 500, shield: 0, description: "地精鼠：潜地仅受旋转水枪伤害，出土后攻击龙渊卡片", speed: 0.9, atk: 10, cycle: 36, range: 90, ash_proof: false, spr: spr_dijing, feature: "land"});
 register_enemy("longyuan_dongfeng", {name: "东风鼠", _obj: obj_ly_dongfeng, hp: 2340, shield: 0, description: "东风鼠：飞至第8列后扇风，使全体空军速度翻倍", speed: 0.3, atk: 10, cycle: 36, range: 90, ash_proof: true, spr: spr_dongfeng, feature: "land"});
 register_enemy("longyuan_gaoqiao", {name: "高跷鼠", _obj: obj_ly_gaoqiao, hp: 660, shield: 0, description: "高跷鼠：跨越普通卡片，避开普通攻击，受灰烬攻击", speed: 0.9, atk: 10, cycle: 42, range: 90, ash_proof: false, spr: spr_gaoqiao_move, feature: "land"});
 register_enemy("longyuan_kailu", {name: "开路鼠", _obj: obj_ly_kailu, hp: 1000, shield: 0, description: "开路鼠：第4、8列冲刺；夜间非冲击/碾压死亡化魂", speed: 0.6, atk: 10, cycle: 42, range: 90, ash_proof: false, spr: spr_kailu_move, feature: "land"});
 register_enemy("longyuan_langyabang", {name: "狼牙棒鼠", _obj: obj_ly_langyabang, hp: 2340, shield: 0, description: "狼牙棒鼠：巨型鼠式重击", speed: 0.27, atk: 900, cycle: 108, range: 120, ash_proof: true, spr: spr_langyabang, feature: "land"});
 register_enemy("longyuan_longmu", {name: "龙母鼠", _obj: obj_ly_longmu, hp: 200, shield: 80, description: "龙母鼠：蛋破后发怒加速", speed: 0.36, atk: 10, cycle: 36, range: 90, ash_proof: false, spr: spr_longmu, feature: "land"});
 register_enemy("longyuan_yaoguan", {name: "药罐鼠", _obj: obj_ly_yaoguan, hp: 1960, shield: 0, description: "药罐鼠：三团魂火减伤，濒死消耗魂火治疗全场魂鼠", speed: 0.6, atk: 10, cycle: 48, range: 90, ash_proof: true, spr: spr_yaoguan_move, feature: "land"});
 register_enemy("longyuan_zhibuji", {name: "织布机鼠", _obj: obj_ly_zhibuji, hp: 3500, shield: 0, description: "织布机鼠：每损失15%生命发射10点穿透梭弹，70/40/10%时减少丝线", speed: 0.3, atk: 10, cycle: 36, range: 90, ash_proof: true, spr: spr_zhibuji, feature: "land"});
 register_enemy("longyuan_zhinian", {name: "执念鼠", _obj: obj_ly_zhinian, hp: 3000, shield: 0, description: "执念鼠：夜间非灰烬死亡化魂，普攻与穿透大招循环", speed: 0.3, atk: 10, cycle: 36, range: 90, ash_proof: true, spr: spr_zhinian_move, feature: "land"});
 register_enemy("longyuan_fuzhou", {name: "符咒鼠", _obj: obj_ly_fuzhou, hp: 1200, shield: 0, description: "符咒鼠：施法放出符咒，符咒存在时无敌并转化最左卡片", speed: 0.3, atk: 10, cycle: 48, range: 90, ash_proof: true, spr: spr_fuzhou_qianjin, feature: "land"});
 register_enemy("longyuan_zhizhujing", {name: "蜘蛛精鼠", _obj: obj_ly_zhizhujing, hp: 800, shield: 0, description: "蜘蛛精鼠：空中降落后用蛛网束缚卡片，夜晚可化魂", speed: 0, atk: 10, cycle: 90, range: 90, ash_proof: true, spr: spr_zhizhujing, feature: "land"});
 register_enemy("longyuan_fuzhou_minion", {name: "符咒随从鼠", _obj: obj_ly_fuzhou_minion, hp: 200, shield: 0, description: "符咒魂鼠：符咒转化的魂体随从", speed: 0.32, atk: 10, cycle: 42, range: 90, ash_proof: true, spr: spr_fuzhou_zhaohuan_qianjin, feature: "land"});
 // ===== 龙渊（长渊）关卡 BOSS（mouse_id 与对象 Create 中的 mouse_id 一致）=====
 register_enemy("ly_diting", {name: "谛听鼠", _obj: obj_ly_boss_diting, hp: 200000, shield: 0, description: "谛听鼠：遁地移动并发动3×3突袭；音波周期性伤害本行卡片；钟可被攻击，受音波或钻出攻击后3秒自毁并生成魂系开路鼠", speed: 0.4, atk: 5000, cycle: 60, range: 90, ash_proof: false, spr: spr_ly_diting_idel, feature: "land"});
 // 哼哈将军：牛头与马面共用一个 ID 与一条生命值，出场时由 _peer_obj 同时生成副体
 register_enemy("ly_hengha", {name: "哼哈将军", _obj: obj_ly_boss_hengha_horseface, _peer_obj: obj_ly_boss_hengha_oxhead, hp: 150000, shield: 0, description: "哼哈将军：牛头与马面共享15万生命值，马面战略转移、掷铃和召唤8个食灵，牛头十字砸击、敲钟和吸收魂体", speed: 0.4, atk: 4000, cycle: 60, range: 90, ash_proof: false, spr: spr_hengha_icon1, feature: "land"});
 register_enemy("ly_mengpo", {name: "孟婆鼠", _obj: obj_ly_boss_mengpo, hp: 300000, shield: 0, description: "孟婆鼠：茶树、降雨、风眼与茶壶浇水", speed: 0.4, atk: 5000, cycle: 60, range: 90, ash_proof: true, spr: spr_ly_mengpo_idel, feature: "land"});
 register_enemy("ly_wuchang", {name: "无常鼠", _obj: obj_ly_boss_wuchang, hp: 250000, shield: 0, description: "无常鼠：拘魂锁链封格锁冷却、献宝元宝牵引玩家并封印武器、勾魂火轮绕场一周、招魂法杖唤出符咒魂鼠，按1-2-3-4技能循环黑白形态轮替", speed: 0.4, atk: 5000, cycle: 60, range: 90, ash_proof: true, spr: spr_wuchang_icon1, feature: "land"});
 register_enemy("ly_youshen", {name: "游神鼠", _obj: obj_ly_boss_youshen, hp: 100000, shield: 0, description: "游神鼠：符箓毒雾、催眠迷阵与纵列冲撞", speed: 0.4, atk: 6000, cycle: 60, range: 90, ash_proof: true, spr: spr_ly_youshen_idel, feature: "land"});
}
