function mod_info_island_init()
{
    // 生肖卡情报岛信息
    register_card_info_island("yanyantu", "\n来源:跨服商店\n[增幅类][增幅产能类]\n炎焱兔：3×3范围指定产火卡片的火苗单值乘以倍率,向下取整,同类增幅取最高值。\n一转：提升火苗增幅倍率。\n二转：增幅范围扩大至5×5。");
    register_card_info_island("wugushe", "\n来源:跨服商店\n[喷壶类][旋转喷壶类]\n巫蛊蛇：3×3范围每轮造成表列总伤害。蛊毒10%概率追加最大生命5%伤害\n上限1000,并秒杀非精英。\n一转：蛊毒概率15%,追加最大生命8%伤害,上限1500。\n二转：攻击范围扩大至5×5。");
    register_card_info_island("kuileima", "\n来源:跨服商店\n[辅助类][伤害转移类]\n傀儡马：生命1亿,最多存在1张。锁定最高血量老鼠,优先BOSS\n按比例转移受伤。持续时间结束或目标死亡时自毁\n不能复制、改变星级或被普通冷却刷新,仅极寒冰沙可刷新。\n一转：死亡时造成5×5范围900灰烬爆炸。\n二转：伤害转移比例翻倍。");
    register_card_info_island("yufengma", "\n来源:跨服商店\n[直射类][直线穿透类]\n御风马：每次发射1枚风弹,击退陆空军0.5格。\n场上存在排风扇、9周年幸运草扇或旋风牛时改为3行大风,可受宴飨女神增幅。\n一转：死亡时产生吹飞效果,基础伤害提升。\n二转：基础伤害翻倍,秒杀表列指定飞行老鼠。");
    register_card_info_island("fenjima", "\n来源:跨服商店\n[直射类][特殊直线类]\n焚寂马：发射1枚直线弹,可被水神、樱桃反弹布丁反弹\n穿过火盆、金牛座、火神时被强化;\n命中老鼠后沿子弹方向分裂0度±90度穿透波,目标格承受全部冲击波。\n一转：冲击波伤害提升50%。\n二转：增加±45度冲击波,共5道。");
    register_card_info_island("guiyuanma", "\n来源:跨服商店\n[追踪类][特殊追踪]\n归元马：前方3行索敌最近目标,1枚追踪弹。秒杀血量低于30%的非BOSS老鼠\n其余非BOSS送回第9列变为原最大生命50%的呆呆鼠,能力同平民鼠。\n受莓果甜点、香料虎、宴飨女神增幅。\n一转：秒杀阈值提升至50%。\n二转：前方5行索敌,发射2枚弹。");
    register_card_info_island("huagao", "\n来源:松露大厅（夜）\n[直射类][固定轨迹类]\n灯影花糕：召唤魂虫从场地两侧对向飞入,攻击沿途上中下3行陆军,\n中路2次、上下各1次。命中魂系老鼠使其现形。\n无论有无鼠军都会定间隔一直攻击;无法攻击未显形幽灵、非主流鼠。\n15次攻击可破1团鬼火。可放岩浆,受音盒马、浮生茶增幅。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：场上≥10张时,攻击力最高的1张每5秒在右上方\n召唤1枚竖向魂虫,攻击第8~9列。\n\n二转能力：攻击力大幅提高,中路4次/上下各2次,横向魂虫+1。");
    register_card_info_island("yanhuangma", "\n来源:跨服商店\n[直射类][固定轨迹类]\n炎凰马：持续从场地左右两侧发射对向固定轨迹炎凰\n攻击3行陆军,中路2次、上下各1次\n无法攻击未显形鬼鼠、非主流,可放岩浆。受音盒马、浮生茶增幅。\n一转：场上至少7张时,最高攻击力的1张每5秒召唤竖向炎凰\n攻击第7至9列,第8列2次。\n二转：攻击提升,击杀化为灰烬。");
    register_card_info_island("yinhema", "\n来源:跨服商店\n[增幅类][增幅固定轨迹类]\n音盒马：3×3范围增幅迷你披萨炉、赖皮蛇、工匠神、炎凰马、炎帝。同类取最高倍率。\n一转：增幅范围扩大至5×5。\n二转：增幅倍率提升。");
    register_card_info_island("fushengcha", "\n来源:松露大厅（夜）\n[增幅类][增幅固定轨迹类]\n浮生茶：3×3范围增幅迷你披萨炉、赖皮蛇、工匠神、炎凰马、灯影花糕、炎帝(神农氏)。\n倍率为[攻击力],同类增幅(含音盒马)取最高,不叠加。\n *星级影响[攻击力],技能影响[冷却时间]。\n\n一转能力：增幅范围扩大至5×5。\n\n二转能力：增幅倍率大幅提升,范围为5×5。");
    register_card_info_island("xiandima", "\n来源:跨服商店\n[追踪类][集火追踪]\n仙笛马：不占格。每攻击间隔的1/3召唤1只,积满3只后飞出\n发射3枚,全屏优先BOSS、其次最高血量目标。\n一转：对BOSS造成2.1倍伤害。\n二转：子弹伤害翻倍,仍为3枚。");
    register_card_info_island("xingqiongma", "\n来源:跨服商店\n[辅助类][种卡类]\n星穹马：前摇1.2秒后复活5×5范围内最近被老鼠咬死的1张卡,排除复制卡。使用后消失。\n一转：范围内卡片获得技能对应时长的免伤\n可抵挡1次老鼠攻击,包括致命攻击\n8级技能抵挡2次。\n二转：一次复活3张。");
    register_card_info_island("starrabbit", "\n来源:跨服商店\n[多向类][类海星类]\n星星兔：前方有老鼠时向五个方向各发射1发穿透星弹,命中老鼠造成伤害\n星弹可穿过火盆等障碍并可被水神、樱桃布丁反弹。\n一转：五个方向各发射1发星弹,伤害提升至2倍。\n二转：五个方向各发射1发星弹,伤害提升至3倍。");
    register_card_info_island("yinghuoshe", "\n来源:跨服商店\n[辅助类][地形类]\n萤火蛇：全屏照亮迷雾;每15秒产生1朵火;老鼠首次进入自身3×3范围时造成一次伤害。\n一转：每15秒产生2朵火。\n二转：伤害翻倍。");
    // 护法神
    register_card_info_island("hufa_god", "\n来源:诸神宝殿\n前置卡片:星火红柳烤串机+游侠双刃蛇\n[喷壶类][旋转喷壶类]\n基础能力：全屏索敌追踪穿透弹,攻击陆、空鼠军,\n秒杀不防爆鼠,15%概率定身1.5秒,命中后继续直线飞出。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：攻击力提升,魂系老鼠1.8倍伤害。\n\n四转能力：追加地鼠目标,攻击力大幅提升。\n\n终转能力：对BOSS造成2倍伤害。");
    register_card_info_island("gaia", "\n来源:诸神宝殿\n前置卡片:加农龙虾炮+死神大炮\n[灰烬类][轰炸类]\n基础能力：当自身三行内出现敌人时,每隔[攻击间隔]秒,就会发射两枚\n毁灭巨石,在本行对应的敌人位置造成3*3范围的灰烬爆炸效果,造成\n[攻击力]点伤害。\n *星级影响[攻击间隔],技能影响[冷却时间]。\n\n三转能力：攻击力提高,眩晕并初始瞬发。\n\n四转能力：增加1发子弹。\n\n终转能力：索敌范围扩大至自身中心5行,爆炸范围扩大至5x5。");
    register_card_info_island("aurora", "\n来源:诸神宝殿\n前置卡片:猪猪发射站+蓝莓信号塔塔\n[增幅类][增幅投掷类]\n基础能力：为本行投掷类卡片增伤,倍率为[攻击力]/100。\n *星级影响[攻击力],技能影响[冷却时间]。\n\n三转能力：死亡后造成3x3爆炸。\n\n四转能力：[攻击力]额外增加30%。\n\n终转能力：增伤范围提升至三行,非本行加成为原来的20%。");
    register_card_info_island("zhurong", "\n来源:诸神宝殿\n前置卡片:如意香烤栗子+驴肉火烧锅\n[投掷类][灼烧投手]\n基础能力：当前方攻击范围内出现敌人时,每隔[攻击间隔]秒,就会投出\n高温火球,点燃身前3x3的地面,对上面的敌人持续造成[攻击力]的伤害。\n-祝融的射程为4格\n-每发子弹总计造成10次[攻击力]的伤害\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：[攻击力]额外提升30%,射程增加一格。\n\n四转能力：点燃范围扩大到5x5。\n\n终转能力：[攻击力]额外提升45%,点燃范围扩大到7x5。");
    register_card_info_island("rig", "\n来源:诸神宝殿\n前置卡片:宇宙星星兔+松塔爆破机\n[多向类][类海星类]\n基础能力：当前方出现敌人时,每隔[攻击间隔]秒,就会向前方5个方向\n发射穿透子弹,对穿过的敌人造成[攻击力]的伤害。\n -场上每存在一个里格,自身的[能量消耗]就会增加50点。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：[攻击力]额外提升10%,能量守恒。\n\n四转能力：攻击力根据场上里格的数量提升。\n\n终转能力：攻击力翻倍。");
    register_card_info_island("brahma", "\n来源:诸神宝殿\n前置卡片:幻幻鸡+双子百变蛇\n[辅助类][种卡类]\n基础能力：在3x3范围内复制两张上一次放下的卡片,优先选择中心和上下\n两格。\n *星级影响[冷却时间],技能无影响。\n\n三转能力：放置造成5x5灰烬爆炸。\n\n四转能力：额外复制一张卡片。\n\n终转能力：再额外复制两张卡片,共5张。");
    register_card_info_island("baibianshe", "\n来源:跨服商店\n[辅助类][种卡类]\n基础能力：变身成为5x5范围内上一张种下的卡片,复制类卡片无法变身。\n *星级影响[冷却时间],技能影响[攻击间隔]。\n\n一转能力：变身范围扩大到全屏。\n\n二转能力：变身数量+2,共3张。");
    register_card_info_island("clotho", "\n来源:诸神宝殿\n前置卡片:梵天神使\n[辅助类][变星类]\n基础能力：放下后一段时间为3x3范围内的所有卡片随机提高或降低星级,\n最高16星,最低0星。\n *星级影响[冷却时间],技能无影响。\n\n三转能力：优化升星概率,必定升星。\n\n四转能力：优化升星概率,影响范围扩大到5x5。\n\n终转能力：优化升星概率,影响范围扩大到5x7。");
    register_card_info_island("time_god", "\n来源:诸神宝殿\n前置卡片:极寒冰沙+幻幻鸡\n[辅助类][冷却类]\n基础能力：种卡之后一段时间内,持续给3x3范围内的卡片缩短冷却时间30%。\n技能影响的是持续作用的时间,种卡之后[攻击间隔]内,持续[技能等级]次数,5等级4次,8等级5次,\n *星级影响[冷却时间],技能影响[冷却时间]。\n\n三转能力：放卡产生爆炸,对附近敌人造成伤害。\n\n四转能力：范围扩大至5x5,冷却缩减50%。\n\n终转能力：范围扩大至全屏,冷却缩减100%。");
    register_card_info_island("warm_birds", "\n来源:商城\n[产能类][主职产火][常规型]\n基础能力：放置1秒后立即生产三朵价值为[火苗产量]的火苗,随后每隔[攻\n击间隔]秒,就会产出三朵火苗。\n *星级影响[攻击间隔],技能影响[火苗产量]。\n\n一转能力：一次可产出四朵火苗。\n\n二转能力：一次可产出五朵火苗,冷却时间减半。");
    register_card_info_island("cold_drew", "\n来源:商城\n[追踪类][散点追踪]\n基础能力：当场上出现敌人时,每隔[攻击间隔]秒根据敌人数量发射至多四\n颗冰块子弹打击敌人,对敌人造成[攻击力]的伤害。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：可以发射的子弹增加一枚,每颗子弹获得20%溅射。\n\n二转能力：固定发射6枚冰块子弹,可集火。");
    register_card_info_island("berry_dessert", "\n来源:商城\n[增幅类][增幅追踪类]\n基础能力：为自身周围3x3范围内的追踪类卡片增伤,倍率为[攻击力]/100。\n *星级影响[攻击力],技能影响[冷却时间]。\n\n一转能力：增伤范围扩大至5x5。\n\n二转能力：[攻击力]固定增加30。");
    register_card_info_island("grilled_lizard_pult", "\n来源:商城\n[投掷类][单线投手]\n基础能力：当前方一行出现敌人时,每隔[攻击间隔]秒,就会投掷一个爆弹,\n爆弹会对主目标造成等同于[攻击力]的伤害,并对3*3范围内的其他目标造\n成35%的溅射伤害。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：[攻击力]额外增加45%。\n\n二转能力：每次攻击可投掷两个爆弹。");
    register_card_info_island("blueberry_tower", "\n来源:商城\n[增幅类][增幅投掷类]\n基础能力：为本行投掷类卡片增伤,倍率为[攻击力]/100。\n *星级影响[攻击力],技能影响[冷却时间]。");
    register_card_info_island("zhuzhujiaqiang", "\n来源:商城\n[增幅类][增幅投掷类]\n基础能力：为本行投掷类卡片增伤,倍率为[攻击力]/100。\n *星级影响[攻击力]和[生命值],技能影响[冷却时间]。\n\n一转能力：[生命值]翻倍。\n\n二转能力：增伤倍率大幅提升。");
    register_card_info_island("donut", "\n来源:商城\n[专业防空类][陆空兼备类]\n基础能力：当前方一行出现敌人时,每隔[攻击间隔]秒,就会根据敌人类型\n连续发射两颗对空/对地甜甜圈子弹,甜甜圈子弹会穿过障碍,对敌人造成\n等同于[攻击力]的伤害。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：[能量消耗]子弹附加3x3范围25%溅射。\n\n二转能力：每次攻击额外射出一发子弹。");
    register_card_info_island("spoon_rabbit", "\n来源:跨服商店\n[投掷类][多线投手]\n基础能力：当前方三行出现敌人时,每隔[攻击间隔]秒,就会投掷三颗爆\n炸萝卜,每行一颗,爆炸萝卜会对主目标造成等同于[攻击力]的伤害,并\n对3*3范围内的其他目标造成35%的溅射伤害。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：中路额外增加一发子弹,共4发。\n\n二转能力：侧路额外增加两发子弹,共6发。");
    register_card_info_island("firework_dragon_real", "\n来源:诸神宝殿\n前置卡片:炽焰花火龙+帝王蛇羹煲\n[产能类][主职产火][特殊型]\n基础能力：放下后经过[准备时间]产出6朵价值[火苗产量]的火苗。\n *星级影响[火苗产量],技能影响[准备时间]。\n\n一转能力：放下后立刻返还种植消耗的火苗。\n\n二转能力：额外产出6朵火苗。");
    register_card_info_island("hspeed_juicer", "\n来源:商城\n[增幅类][增幅喷壶类]\n基础能力：为自身周围3x3范围内的喷壶类卡片增伤,倍率为[攻击力]/100。\n *星级影响[攻击力],技能影响[冷却时间]。\n\n一转能力：[攻击力]固定增加25。\n\n二转能力：增伤范围扩大至5x5。");
    register_card_info_island("shuangzi", "\n来源:商城\n[产能类][主职产火][常规型]\n基础能力：放置后生产四朵价值为[火苗产量]的火苗,随后每隔[攻\n击间隔]秒,就会产出四朵火苗。\n *星级影响[攻击间隔],技能影响[火苗产量]。\n\n一转能力：冷却时间减少。\n\n二转能力：一次可产出六朵火苗,冷却时间减少。");
    register_card_info_island("sheshou", "\n来源:商城\n[直射类][三线类]\n基础能力：同时向正前方三行发射4发强力箭,中间2发,两边各1发\n,威力巨大！\n*星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：能量守恒(不＋)。\n\n二转能力：攻击次数增加,每次攻击向前方三行各射\n出2发（共6发）强力子弹。");
    register_card_info_island("athena", "\n来源:商城\n[追踪类][群轰追踪]\n基础能力：普通能力：高频率发射激光武器,全屏跟踪轰炸,强力范围伤害。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：连射两发激光。");
    register_card_info_island("tiancheng", "\n来源:商城\n[直射类][水管类]\n基础能力：对前后各发射3发强力子弹,威力与实力的象征。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：前后各增加1发子弹。");
    register_card_info_island("shuangyu", "\n来源:商城\n[投掷类][单线投手]\n基础能力：投掷两发强力冰鱼并产生溅射伤害40%,威力强大。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：能量守恒,[能量消耗]不再增加。\n\n二转能力：子弹威力提升35%。");
    register_card_info_island("juxie", "\n来源:商城\n[追踪类][飞镖追踪]\n基础能力：扔出4发强力大钳子,全屏跟踪,无死角攻击。\n -巨蟹座可以放置在陆地和水面上。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：增加2发子弹。");
    register_card_info_island("shizi", "\n来源:商城\n[喷壶类][旋转喷壶类]\n基础能力：连续快速向周边发出猛烈攻击,海陆空交通管制。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：范围威力增加25%。");
    register_card_info_island("jinniu", "\n来源:商城\n[增幅类][子弹增幅][平射增幅]\n基础能力：凡是穿透它能变成火弹的子弹,威力伤害超强提升,冰弹除外。\n *星级影响[攻击提升倍率],技能影响[冷却时间]。\n\n一转能力：耗能减少50。\n\n二转能力：威力增加12%");
    register_card_info_island("chunv", "\n来源:商城\n[防御类][护罩类]\n基础能力：保护被他罩住的卡片,对啃它的老鼠造成一定伤害,体力更高。\n *星级影响[生命值],技能影响[冷却时间]。\n\n一转能力：爆破伤害增加30%。\n\n二转能力：爆破范围增加到5*5");
    register_card_info_island("baiyang", "\n来源:商城\n[灰烬类][瞬发类][冲撞类]\n基础能力：释放一只白羊精灵,对陆地上的小老鼠造成毁灭性伤害。\n *星级影响[冷却时间],技能影响[攻击力]。\n\n一转能力：降低能耗至200点。\n\n二转能力：增加上下两行,对三行鼠军造成伤害");
    register_card_info_island("mojie", "\n来源:商城\n[灰烬类][持续类]\n基础能力：对范围内造成巨大冰暴伤害,老鼠持续减速扣血,卡片存在一定\n时间后消失。\n *星级影响[攻击力],技能影响[冷却时间]。\n\n一转能力：[攻击间隔]减半。\n\n二转能力：增加攻击范围");
    register_card_info_island("corn_shooter", "\n来源:商城\n[直射类][传统直线类]\n基础能力：当前方一行内出现敌人时,就会每隔[攻击间隔]秒直线发射三颗\n伤害为[攻击力]的玉米（可过火）。\n *星级影响[攻击力],技能影响[冷却时间]。\n\n一转能力：增加三发子弹且能量守恒（不+）。\n\n二转能力：子弹威力增加30%。");
    register_card_info_island("sun_god", "\n来源:诸神宝殿\n前置卡片:双子座星宿+太阳能高效炉\n[产能类][主职产火][常规型]\n基础能力：产能突破极限,每隔一段\n[攻击间隔]产出6朵火苗,放置后立即生产。\n *星级影响[攻击间隔],技能影响[火苗产量]。\n\n三转能力：一次生产8朵火苗,冷却与耗火略微降低。\n\n四转能力：一次生产10朵火苗,冷却与耗火进一步降低。\n\n终转能力：一次生产12朵火苗,冷却与耗火大幅降低,首次产量翻倍");
    register_card_info_island("moon_god", "\n来源:诸神宝殿\n前置卡片:巨蟹座星宿+火影章鱼烧\n[追踪类][飞镖追踪]\n基础能力：连续发射6发全屏追踪型攻击的子弹,海陆空兼顾。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：增加1发子弹。\n\n四转能力：每组首发的子弹变身超级子弹,\n超级子弹拥有200%伤害并对3×3范围内敌人造成75%溅射。\n\n终转能力：增加一发子弹,场上每个月神增加5%伤害,最高至145%");
    register_card_info_island("war_god", "\n来源:诸神宝殿\n前置卡片:天秤座星宿+合金水管\n[直射类][水管类]\n基础能力：前后方分别同时发射4发强力子弹,一共8发。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：前后增加1发子弹。\n\n四转能力：前方每四轮额外射出一发超级子弹,超级子弹拥有800%攻击力。\n\n终转能力：后方每四轮也额外射出一发超级子弹,超级子弹拥有1200%攻击力");
    register_card_info_island("hera", "\n来源:诸神宝殿\n前置卡片:处女座星宿+锋芒瓜皮护罩\n[防御类][护罩类]\n基础能力：保护被罩的卡片,反伤啃咬它的老鼠,消失后对5×5范围造成\n一次等同剩余生命值的物理伤害与等同最大生命值的爆炸伤害。\n *星级影响[生命值],技能影响[冷却时间]。\n\n三转能力：增加25%体力。\n\n四转能力：给被保护的卡片增加1000体力。\n\n终转能力：一次种植3个,优先正上与正下方");
    register_card_info_island("thor", "\n来源:诸神宝殿\n前置卡片:双鱼座星宿+强袭煮蛋器\n[投掷类][单线投手]\n基础能力：连续发出2发带有强力溅射伤害40%和减速效果的冰锤。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：增加1发冰锤,但攻击力降低,总伤害增加20%。\n\n四转能力：溅射伤害提升至45%,每3轮额外投出1发超级子弹,\n超级子弹拥有200%伤害。\n\n终转能力：每轮增加一发超级子弹,溅射伤害提升至100%");
    register_card_info_island("poseidon", "\n来源:诸神宝殿\n前置卡片:狮子座星宿+原子咖啡壶\n[喷壶类][旋转喷壶类]\n基础能力：连续向周围5*5格发出2发水波攻击,范围伤害能力高度提升。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：攻击力提升20%并附加减速效果。\n\n四转能力：增加1发水波攻击。\n\n终转能力：范围提升至7×5,总伤害提升85%");
    register_card_info_island("love_god", "\n来源:诸神宝殿\n前置卡片:射手座星宿+终结者酒架\n[直射类][三线类]\n基础能力：向正前方三行分别射出2发子弹,一共6发。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：中路增加1发子弹。\n\n四转能力：侧路各增加1发子弹。\n\n终转能力：每四轮额外发射三发超级子弹,\n超级子弹拥有300%伤害,且可穿透敌人与障碍");
    register_card_info_island("zeus", "\n来源:诸神宝殿\n前置卡片:雅典娜光辉+加农龙虾炮\n[追踪类][群轰追踪]\n基础能力：全屏发射两发强力闪电攻击,造成3×3强力范围伤害。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：攻击力提升20%。\n\n四转能力：增加一发闪电。\n\n终转能力：增加两发闪电,范围变为5×5。");
    register_card_info_island("ghost_god", "\n来源:诸神宝殿\n前置卡片:芥末海星刺身\n[多向类][海星类]\n基础能力：向五个方向分别发射一枚强力子弹。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：增加一发附带减速和穿透的次级子弹,但伤害仅有20%。\n\n四转能力：次级子弹攻击力翻倍（40%）。\n\n终转能力：所有子弹变为次级子弹,但次级子弹现在拥有100%伤害。");
    register_card_info_island("ice_god", "\n来源:诸神宝殿\n前置卡片:迅捷冷萃机+杂果冰桶炸弹\n[追踪类][散点追踪]\n基础能力：召唤冰晶,攻击全屏8个敌人,附加减速。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：耗能减少,冰晶带有3*3的40%溅射伤害。\n\n四转能力：攻击力提升,攻击数量+2。\n\n终转能力：攻击力大幅提升,攻击数量＋2。");
    register_card_info_island("odin", "\n来源:诸神宝殿\n前置卡片:游侠双刃蛇\n[直射类][过火穿透类]\n基础能力：向前方发射1发强化穿透短矛（2倍伤害）。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：攻击力提升25%（2.5倍伤害）。\n\n四转能力：伤害提升至3.75倍。\n\n终转能力：伤害提升至5倍。");
    register_card_info_island("fire_god", "\n来源:诸神宝殿\n前置卡片:金牛座星宿+岩烧烤盘\n[增幅类][子弹增幅][平射增幅]\n基础能力：穿过后变成高温子弹,并且伤害能力得到飞升,冰弹无效。\n *星级影响[攻击提升倍率],技能影响[冷却时间]。\n\n三转能力：伤害再度提升20%。\n\n四转能力：被火子弹击中后,对当前格的敌人附加50%火焰群伤\n\n终转能力：增幅倍率再次提升20%,被火子弹击中后,对3×3范围内的敌人\n附加80%火焰群伤,\n*被直接击中的目标也会受到该伤害。");
    register_card_info_island("water_god", "\n来源:诸神宝殿\n前置卡片:热量反弹布丁\n[辅助类][反弹类]\n基础能力：将大多数命中自己的直射子弹反弹至相反的方向,并使它们的伤\n害增加[攻击力]点。每个子弹只能被反弹一次。\n *星级影响[攻击力]和[生命值],技能影响[冷却时间]。\n\n三转能力：[能量消耗]降低至75。\n\n四转能力：[攻击力]额外增加。\n\n终转能力：反弹子弹伤害翻倍。");
    register_card_info_island("power_god", "\n来源:诸神宝殿\n前置卡片:热狗榴弹炮+七彩糖葫芦弹\n[专业防空类][纯对空类]\n基础能力：发射两发强力子弹追踪攻击空中鼠军\n\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：威力提升35%,定身加强。\n\n四转能力：增加1发子弹。\n\n终转能力：再增加一发子弹且触发灰烬效果。");
    register_card_info_island("sheng_huo", "\n来源:诸神宝殿\n前置卡片:海鲜肥牛锅+酱香鱿鱼锅\n[喷壶类][直线喷壶类]\n基础能力：施展火焰术,向前方3行释放神圣穿透型火焰,灼烧沿途鼠军\n\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：伤害大幅度提升, 几率眩晕,灰烬效果。\n\n四转能力：可伤害老鼠类型增加空中和地下。\n\n终转能力：同类卡片可提升伤害,几率产生暴烈一击。");
    register_card_info_island("save_god", "\n来源:诸神宝殿\n前置卡片:白羊座星宿+璀璨金牛烟花\n[灰烬类][瞬发类][冲撞类]\n基础能力：化身为4条灵鱼,冲撞沿途遇到的老鼠\n\n *星级影响[冷却时间],技能影响[攻击力]。\n\n三转能力：无需格子。\n\n四转能力：增加2条灵鱼,几率清理障碍。\n\n终转能力：增加2条灵鱼,清理遇到的路障。");
    register_card_info_island("joker", "\n来源:诸神宝殿\n前置卡片:女王多拿滋\n[专业防空类][陆空兼备类]\n基础能力：连续发射3发带有溅射效果的子弹,先后攻击本行\n\n空、地、水陆老鼠\n\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：溅射伤害提升,死亡蝙蝠效果。\n\n四转能力：增加1发子弹。\n\n终转能力：溅射伤害提升。");
    register_card_info_island("ymir", "\n来源:诸神宝殿\n前置卡片:花椒蜥蜴投手+盖世勺勺兔\n[投掷类][多线投手]\n基础能力：向前方三行投出共6发巨锤,带有45%溅射伤害。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：中路增加一发巨锤,攻击力提升10%,溅射伤害提升至50%。\n\n四转能力：侧路各增加一发巨锤,攻击力再提升10%,击杀附带灰烬效果\n\n终转能力：每路增加一发巨锤,攻击力再额外提升20%");
    register_card_info_island("xiangshui_god", "\n来源:诸神宝殿\n前置卡片:流心莓果点心\n[增幅类][增幅追踪类]\n基础能力：为周围陆地追踪卡片提升大幅攻击力,同类卡片效果不叠加。\n *星级影响[攻击力]（倍率=攻击力/100）,技能影响[冷却时间]。\n\n三转能力：攻击力提升。\n\n四转能力：冰神类卡片共享增幅。\n\n终转能力：范围扩大至5x7,增幅倍数大幅提升,同类卡片加成可叠加2次。");
    register_card_info_island("fengrao_god", "\n来源:诸神宝殿\n前置卡片:燎原战旗马+泰斗五行蛇\n[增幅类][增幅五向类]\n基础能力：为5*5范围内五向类卡片增加攻击力,倍率为[攻击力]/100。\n *星级影响[攻击力]（倍率=攻击力/100）,技能影响[冷却时间]。\n\n三转能力：追加多向类卡片增幅,五向及多向类卡片均可增幅。\n\n四转能力：[攻击力]大幅提升,增幅倍率显著增加。\n\n终转能力：同类卡片加成可叠加2次（倍率相加）。");
    register_card_info_island("houyi_god", "\n来源:诸神宝殿\n前置卡片:游侠双刃蛇+烤灯笼鱼酒架\n[直射类][过火穿透类]\n基础能力：向前方3路发射3发穿透箭矢（3倍伤害）,一定几率产生三昧真火灼烧鼠军。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：灼烧效果提升,中路子弹4倍伤害,边路3倍。\n\n二转能力：全弹4倍伤害,子弹击杀化为灰烬。\n\n终转能力：全弹5倍伤害,三昧真火叠加伤害翻倍。");
    register_card_info_island("heian_god","\n来源:诸神宝殿\n前置卡片:摩羯座星宿+冰河世纪榴莲\n[灰烬类][持续类]\n基础能力：对5*5的鼠军产生大量伤害,持续一段时间后消失。\n *星级影响[攻击力],技能影响[持续时长]。\n\n三转能力：伤害大幅提升。\n\n四转能力：范围扩大至5*7。\n\n终转能力：每攻击一次敌人伤害翻倍,\n击杀增加灰烬效果");
    register_card_info_island("gongjiang_god", "\n来源:诸神宝殿\n前置卡片:大王赖皮蛇+拉丝披萨炉\n[直射类][固定轨迹类]\n基础能力：发射1发河豚子弹（4倍伤害）沿固定轨迹往返,\n可攻击地下/陆地/飞行老鼠。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：子弹威力提升,25%概率附加河豚毒素,\n20%概率定身1.5秒。\n\n二转能力：子弹威力提升至5倍,25%概率释放河豚毒素。\n\n终转能力：第1、2列增加上下竖向子弹,\n30%概率附加河豚毒素。");
    register_card_info_island("hundun_god", "\n来源:诸神宝殿\n前置卡片:牛肉双黑汉堡\n[非远程类][吞噬类]\n基础能力：吞噬5*5范围内的普通敌人（秒杀）,\n对精英敌人造成4500伤害,死亡时产生3*3灰烬爆炸。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：吞噬范围扩大,精英伤害提升至6000,\n死亡爆炸范围5*5。\n\n四转能力：上古神·混沌,纵向吞噬范围扩大,\n同时吞噬多个敌人。\n\n终转能力：至尊上古神,自身右侧为中心5×7范围吞噬普通鼠军,\n对精英鼠造成9000伤害,死亡时产生5×5灰烬爆炸。");
    register_card_info_island("guangming_god","\n来源:诸神宝殿\n前置卡片:莲花玉兔灯笼+九天皓日火龙果\n[灰烬类][持续类]\n基础能力：每隔一段时间在自身周围召唤5*5格圣光攻击范围内鼠军。\n *星级影响[攻击力],技能影响[冷却时间]。\n\n三转能力：和铲子碰撞发生爆炸。\n\n四转能力：场上卡片数量增加1,伤害增加1倍。\n\n终转能力：范围扩大至5*7");
    register_card_info_island("mozhang", "\n来源:商城\n[增幅类][增幅喷壶类]\n基础能力：为周围3*3范围内的旋转攻击卡片和本行直线喷射类卡片\n提升攻击力,倍率为[攻击力]/100。\n *星级影响[攻击力],技能影响[冷却时间]。\n\n一转能力：旋转类卡片加成范围扩大到5*5。\n\n二转能力：[攻击力]大幅提升。");
    register_card_info_island("lingrong_god", "\n来源:诸神宝殿\n前置卡片:彩虹棉花糖\n[辅助类][承载类]\n基础能力：三合一承载卡片,可在海底、陆地、水面、岩浆上\n承载卡片并填补空洞。\n *星级影响[冷却时间]。\n\n三转能力：竖向生成三张,三合一承载卡片。\n\n四转能力：直接生成九张,三合一承载卡片。");
    register_card_info_island("12yinliao", "\n来源:商城\n[辅助类][增益类]\n基础能力：每隔[攻击间隔]秒释放全屏美食,立即将体力回满。\n *对老鼠不造成伤害。\n *星级影响[冷却时间],技能无影响。");

    register_card_info_island("dandantu", "\n来源:商城\n[灰烬类][触发类][常规类]\n基础能力：储存3x3范围内子弹伤害,按[攻击力]%比例储存（上限3000）,\n死亡或铲除时从屏幕左边召唤穿透型子弹攻击整行老鼠。\n储存达上限20%时70%几率头顶蛋成长一次。\n *星级影响[攻击力]和[冷却时间]。\n\n一转能力：存伤上限提升至6000。\n\n二转能力：作用行数提升至3行。");
    register_card_info_island("laipishe", "\n来源:跨服商店\n[直射类][固定轨迹类]\n基础能力：无论场上是否有鼠军,每隔[攻击间隔]秒召唤一发海胆子弹,\n子弹沿固定路线经过(9,7)和(9,1)后返回原格,对沿途海陆空敌人造成[攻击力]点伤害。\n -同一发子弹对同一目标只造成一次伤害\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：生成一发200%伤害海胆子弹。\n\n二转能力：生成一发300%伤害海胆子弹,子弹击杀目标后附加泡沫减速效果。");
    register_card_info_island("nizhuanniu", "\n来源:商城\n[辅助类][怪物转移类]\n基础能力：将自身周围3*3范围内的普通老鼠逆转到其所在行的出生位置（最右边）。\n *星级影响[卡片冷却速度],该防御卡不支持技能。\n *对boss、鼹鼠无效。\n\n一转能力：被逆转的老鼠额外受到1000点物理伤害。\n\n二转能力：逆转范围扩大到5*5。");
    register_card_info_island("shegengbao", "\n来源:商城\n[产能类][主职产火][特殊型]\n基础能力：无需格子,对准想要回收能量的格子种卡,返还该格全部卡片的火苗能量。\n *星级影响[卡片冷却速度],该防御卡不支持技能。\n\n一转能力：放置不消耗能量。\n\n二转能力：返还能量翻倍。");

    register_card_info_island("zhiyumiao", "\n来源:商城\n[辅助类][增益类]\n基础能力：为5*5范围内卡片瞬间恢复50点体力。\n *星级影响[冷却时间],该防御卡不支持技能。\n\n一转能力：额外增加3秒补血Buff,体力提升至80。\n\n二转能力：全屏补血,保留3秒补血Buff。");
    register_card_info_island("wanpilong", "\n来源:商城\n[辅助类][种卡类]\n基础能力：选择一张己方卡片,经过3.1秒前摇后,将其移动到周围5x5范围内的空格。\n移动保留卡片所有状态（血量、星级、冷却、增益等）。\n *星级影响[冷却时间],该防御卡不支持技能强化。\n\n一转能力：移动范围扩大至全屏任意合法空格。\n\n二转能力：除卡片外,还可以移动己方角色到任意合法空格。");
    register_card_info_island("double_blade_snake", "\n来源:跨服商店\n[直射类][直线穿透类]\n基础能力：向前发射2发穿透剑气子弹,可斩杀生命值\n≤15%的普通老鼠。精英鼠触发斩杀时造成5倍子弹伤害。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：子弹数量+1。\n\n二转能力：子弹数量+1,斩杀阈值提升至25%,\n精英斩杀提升至10倍。");
    register_card_info_island("baobaoji", "\n来源:商城\n[辅助类][地形类]\n基础能力：部署时清除3×3范围内的路障、梯子和鼠洞。\n全天可部署,不造成伤害,清障不消耗体力。\n *星级影响[冷却时间],该防御卡不支持技能。\n\n一转能力：耗能从275降至225,其他能力继承。\n\n二转能力：清除范围扩大到5×5,耗能保持225。");
    register_card_info_island("xuanfengniu", "\n来源:跨服商店\n[辅助类][地形类]\n基础能力：吹走全屏特定空中老鼠。\n全天可部署,不造成伤害,吹走不产生击杀奖励。\n *星级影响[卡片冷却速度],该防御卡不支持技能。\n\n一转能力：额外吹走全屏老鼠产生的障碍物,并兼容清障（老鼠洞、飞猪、海胆、梯子、弹簧）。\n\n二转能力：不需要格子,不占用网格容量,仍消耗300耗能并拥有1000体力。");
    register_card_info_island("qingse_shishi", "\n来源:商城\n[灰烬类][触发类][碾压类]\n基础能力：向前方3×3范围内的老鼠发起重击,造成[攻击力]\n点伤害。\n *星级影响[冷却时间],该卡不支持技能强化。\n\n一转能力：召唤3个柿子同时发起重击,竖向分布,\n伤害可叠加。\n\n二转能力：召唤5个柿子同时发起重击,可攻击空中敌人。");
    register_card_info_island("anranxiaohunfan", "\n来源:商城\n[辅助类][种卡类]\n基础能力：放置后复活3×3范围内1个死亡的美食卡片,保留原卡片的星级、形态和技能状态。\n *星级影响[冷却时间],该卡不支持技能。\n\n一转能力：耗能降低。\n\n二转能力：复活数量提升至2个。");
    register_card_info_island("liehuohu", "\n来源:商城\n[产能类][储能产火]\n基础能力：每隔[攻击间隔]秒生产1朵价值为[火苗产量]的火苗,\n火苗先进入储能,点击收集后返还玩家;\n卡片消失时一次性返还剩余储能。储能上限1500。\n *星级影响[攻击间隔]。\n\n一转能力：每次同时生产2朵火苗。\n\n二转能力：每次同时生产2朵火苗,\n储能上限提升至3000。");
    register_card_info_island("panduola_god", "\n来源:诸神宝殿\n前置卡片:青芥末河豚+燃烧可乐弹\n[灰烬类][瞬发类][爆炸类]\n基础能力：放下后立即产生3×3范围灰烬爆炸,\n造成[攻击力]点伤害,并在本行留下3次毒气伤害。\n *星级影响[攻击力]。\n\n一转能力：毒气伤害+35%。\n\n二转能力：毒气范围+1行,全屏8000灰烬爆炸,\n随后每1秒造成鼠疫伤害×3次。\n\n终转能力：全屏8000灰烬爆炸并造成三次鼠疫伤害。");
    register_card_info_island("chongsheng_god", "\n来源:诸神宝殿\n前置卡片:浩瀚星穹马+天妇罗盖饭\n[辅助类][种卡类]\n基础能力：5*5范围内监听卡片死亡并复活,每隔[冷却时间]复活范围内死亡的卡片。\n首次触发复活时给范围内所有卡片施加减伤BUFF,复活上限4张。\n *星级影响[冷却时间],技能影响[减伤效果]。\n\n三转能力：复活上限提升至6张,减伤效果增强。\n\n四转能力：复活上限6张,减伤BUFF持续时间延长。\n\n终转能力：范围扩大至5*7,复活上限提升至9张,减伤大幅增强。");
    register_card_info_island("haiyang_god", "\n来源:诸神宝殿\n前置卡片:凤羽魔杖蛇+大菠萝榨汁机\n[增幅类][增幅喷壶类]\n基础能力：为5×5范围内喷壶类、5×1范围内附加类、本行咖啡喷壶类\n卡片增伤,倍率为[攻击力]/100。\n *多个海洋女神的增幅不叠加,取最高倍率。\n *星级影响[攻击力],技能影响[冷却时间]。\n\n三转能力：悬浮卡,不占用格子。\n\n四转能力：[攻击力]大幅提升。\n\n终转能力：场上满4张海洋女神后,增幅范围扩大至全屏。");
    register_card_info_island("zhanqima", "\n来源:跨服商店\n[增幅类][增幅所有卡片类]\n基础能力：为5×5范围内所有卡片提高基础攻击力,倍率为[攻击力]/100,持续[攻击间隔]后消失。\n *多个战旗马的增幅不叠加,取最高倍率。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：不占用格子。\n\n二转能力：范围扩大至全屏,增幅提升。");
    register_card_info_island("shennong_god", "\n来源:诸神宝殿\n前置卡片:焚天炎凰马+梦境灯影花糕\n[直射类][固定轨迹类]\n基础能力：召唤2只沿固定行轨迹移动的穿透神焰,攻击2行敌人,\n可攻击空中、地下单位,击杀敌人产生灰烬。\n *场上炎帝数量大于7时,增加一行攻击轨迹。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n三转能力：攻击力提升,神焰伤害增强。\n\n四转能力：攻击力大幅提升。");
    register_card_info_island("hongliukaochuan", "\n来源:百味关\n[喷壶类][旋转喷壶类]\n基础能力：全屏索敌发射追踪穿透串,攻击陆地、空中和幽灵类老鼠。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：攻击力提高。\n\n二转能力：子弹数量+1。");
    register_card_info_island("pufferfish", "\n来源:商城\n[灰烬类][瞬发类][爆炸类]\n基础能力：是美食也可能是毒药,种卡后清除全屏老鼠,或者清除部分卡片。\n *星级影响[冷却时间],技能影响[无]。\n\n一转能力：毒素效果降低。\n\n二转能力：中毒几率降低。");
    register_card_info_island("yeziguo", "\n来源:跨服商店\n[灰烬类][触发类][碾压类]\n基础能力：跳起秒杀前方单格鼠军,并砸晕周围的老鼠。\n *星级影响[冷却时间],技能影响[攻击力]。\n\n一转能力：秒杀范围扩大到3*3。\n\n二转能力：可连砸3次。");
    register_card_info_island("chunsun", "\n来源:赤霞渡（日）\n[灰烬类][持续类]\n基础能力：准备一段时间之后,可以长出穿刺老鼠的春笋。\n对范围内所有陆、地鼠军造成[攻击力]点伤害并直接秒杀击飞陆地非防爆鼠。\n攻击5次或持续45s即消失。\n *星级影响[攻击力],技能影响[准备时间]。\n\n一转能力：笋子存在时间延长至90s。\n\n二转能力：笋子攻击范围扩大到3×5。");
    register_card_info_island("mixian", "\n来源:松露大厅（日）\n[辅助类][地形类]\n基础能力：连接5*5范围内的1个龙柱,1张即可封印龙柱,2张连接\n同一个龙柱可净化龙柱。攻击5*5范围内的陆军。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n一转能力：被老鼠啃咬时反伤。\n\n二转能力：攻击力提升。");
    register_card_info_island("niuyouguo", "\n来源:跨服商店\n[多向类][三向类]\n基础能力：向前方三个方向各发射1发扇形穿透飞镖,可穿透老鼠与障碍。\n *星级影响[攻击力],技能影响[攻击速度]。\n\n一转能力：命中的老鼠附加减速效果。\n\n二转能力：每个方向增加1发飞镖。");

    // 龙渊关卡敌人情报岛信息
    register_enemy_info_island("longyuan_pingmin", "龙渊平民鼠：普通行走并啃食前方卡片。")
    register_enemy_info_island("longyuan_dijing", "地精鼠：入场时以0.9的速度挖掘，地下时仅能被旋转喷射类伤害命中。\n到达地图左侧后出土并眩晕，随后以0.15的速度向右移动并攻击前方卡片。")
    register_enemy_info_island("longyuan_dongfeng", "东风鼠：空中单位，生命值与机械投弹鼠同档。飞到第8列后扇风\n使场上空中鼠移动速度翻倍;扇子被破坏后风效停止。")
    register_enemy_info_island("longyuan_gaoqiao", "高跷鼠：空中单位，未被高体型美食或米线及与龙柱的链路拦截时，遇到普通卡片直接无视，不啃咬而是跨越，不会被任何攻击卡索敌，只接受灰烬攻击。被拦截后自动向右退场")
    register_enemy_info_island("longyuan_kailu", "开路鼠：夜晚非碾压或冲撞击杀时，死后恢复满血转为魂系。魂体接受控制效果，免疫一切灰烬，对普通攻击减伤90%。仍拥有第 4、8 列冲刺能力，接触卡片时会摧毁卡片并自爆，死后不会再次转为魂系.")
    register_enemy_info_island("longyuan_langyabang", "狼牙棒鼠：巨型重型鼠，拥有高生命值和高额近战伤害，会持续压迫前方防线。")
    register_enemy_info_island("longyuan_longmu", "龙母鼠：携带魂蛋，魂蛋破碎后进入发怒状态并提高移动速度。")
    register_enemy_info_island("longyuan_yaoguan", "药罐鼠：魂系状态，生命值低于最大生命值 30% 时，给全体魂系老鼠回血至多三次。")
    register_enemy_info_island("longyuan_zhibuji", "织布机鼠：碾压碰到的卡片，免疫减速和控制。生命值首次下降至85%，70%，55%，40%，25%，10%时，向左各发射一枚具有10点伤害，可沿本行持续穿透攻击的梭弹。梭弹经过火盆类，即平射增幅类卡片时会消失，不会对火盆类造成伤害，且不会触发猫。作为车类，织布机鼠可被鱼刺类和泡椒春笋秒杀")
    register_enemy_info_island("longyuan_zhinian", "执念鼠：普通攻击造成10点伤害。夜晚被击杀且不是灰烬死亡时会化为魂体\n魂体普通攻击造成50点伤害，并按三次普攻、一次大招循环\n大招前移2格，对沿途两格美食各造成100点穿透伤害。")
    register_enemy_info_island("longyuan_fuzhou", "符咒鼠：进入第4、6、8列时各召唤一次符咒。\n符咒飞行或转化出的魂系小鼠存活期间本体无敌;\n符咒会将本行最左侧卡片转化为魂系小鼠。")
    register_enemy_info_island("longyuan_zhizhujing", "蜘蛛精鼠：拥有蜘蛛丝和魂系相关能力\n会在关卡中使用专属动作与技能\n魂体状态受到的伤害降低60%。")
    register_enemy_info_island("longyuan_fuzhou_minion", "符咒魂鼠：由符咒鼠的符咒转化卡片后生成\n拥有独立的魂系行动和攻击能力。")
    register_enemy_info_island("ly_diting", "谛听鼠：\n技能1.地脉突袭。 钻入地下后高速横移，转移到场地上3*3范围内，拥有卡片的格子数最多的一格之一出现，钻出后对3×3格内卡片摧毁\n技能2.梵钟囚魂：随机用钟罩住场上7张卡，钟基础血量1w，如果钟收到音波子弹或Boss遁地钻出后的进攻，则钟3s后自毁，原地产生一个魂系开路鼠\n技能3.魂音回煞： 在随机3行生成音波，对本行卡片摧毁。")
    register_enemy_info_island("ly_hengha", "哼哈将军：\n技能1：冥狱冲阵。马面从第4行进场到（4,6）后，向上移走，牛头随机选3-7列2-6行的某一格，对5×5的十字范围造成各400伤害\n技能2：锁魂鸣钟。马面在2-6随机一行从右向左进入地图停在第8列，向本行扔1个铜钟随机罩住第2列或第5列的卡片，随后消失，牛头跳到钟所在格子前方第4格，先冲撞2格，摧毁这2格所有卡片，再敲一次钟，对钟周围3*3造成40伤害\n技能3：聚魂归冥。马面从钟右一列地图上方向下飞到钟右上一格，顺时针环绕一周，产生围绕钟的8个美食灵体，然后向上飞出。牛头同时随机跳到第8列一格进行吸魂，魂体开始向第9列移动，移动到第9列时牛头跳到第9列再次吸魂。")
    register_enemy_info_island("ly_mengpo", "孟婆鼠：\n技能1：忘川雨润。随机到第7列或第0列某一行，在茶树周围3*3产生降雨，茶树生长，雨停后树周围生蘑菇，摧毁该格卡片。\n技能2：迷风蔽目。降临到随机位置，全屏产生风暴，风向为左、右、上、下随机，作用于各行各列，并对风暴风眼上的卡片造成每秒50点的伤害，持续10秒，此时7*9格子四周产生风场特效，boss处于迷雾之中。\n技能3：孟汤涤忆。先到茶树采茶，茶树恢复枯枝状态，随后随机到某一行第9列，进入茶壶，茶壶沿轨迹，先从该行向左到1列，再随机往上或往下走2格，再向右走到第9列浇茶水，沿途所有格子上，卡片降低5星。浇完茶水从茶壶出来")
    register_enemy_info_island("ly_wuchang", "无常鼠：\n技能1：拘魂定魄。黑无常随机到某一行第9列，向本行第2列投出锁链，拉回后本行2-9列有卡片的格子全部出现1w基础血量的锁链，锁链在击毁前，本格卡片不受顽皮龙影响，不可铲除，不影响本格卡片的作用，但是会锁定本格所有卡片的CD\n技能22：献宝索命。白无常随机到第2列随机位置，然后向7-9列随机位置丢一块元宝，元宝在掉落瞬间摧毁该格卡片并以锁链链接随机一个玩家，将玩家与元宝互换位置并扣除玩家一半血量，玩家自身出现交叉锁链，交叉锁链存在25秒，该25s内无法被顽皮龙转移，无法使用武器，并且吸收场上火苗。\n技能3.勾魂巡界。 黑无常降落至（7,1）踩扁该格美食，扔出魂勾，魂勾从（1，9）出现，按照顺时针沿地图最外圈移动完整一周，摧毁沿途卡片，随后黑无常出现在（1,9)回收\n技能4.符杖穿刺.白无常随机到（1,8）或（7,8)，沿对角线方向扔出法杖，飞到（7,2）或（1,2）。沿途如果有格子存在非承载卡，则秒杀该格承载卡之外所有卡，并在该格生成一个符咒魂鼠。如果只有承载卡或无卡则直接飞过。")
    register_enemy_info_island("ly_youshen", "游神鼠：\n技能1：夜巡雾煞。 随机在2-6某一行右边进入到第10列，丢出一张夜巡符咒，命中本行随机2-7列，夜巡符咒会释放10s黑色毒雾，每秒对3乘3区域所有卡片（包括护罩内的）造成10点伤害，然后回收\n技能2.游踪入梦。 随机到2-5行，2-5列的某一格，以这一格作为出发点，然后按照∞轨迹移动一周，移动完成后能催眠4*6范围卡片15s\n技能3.梦浪荡魂。在4-6随机一列从上往下或从下往上，缓慢冲撞摧毁该列的所有美食包括承载卡")
	register_enemy_info_island("landuo_longzhu", "懒惰龙柱:未封印时，每15s对自身 3×3 范围卡片施加催眠。\n已封印时，每 15s对自身 3×3 范围卡片施加清醒效果")
	register_enemy_info_island("baoshi_longzhu", "暴食龙柱:未封印时，每15s摧毁自身 3×3 范围卡片。\n已封印时，每 15s给自身 3×3 范围卡片施加保护")
	register_enemy_info_island("tanlan_longzhu", "贪婪龙柱:未封印时，若场上n根龙柱有m<n根被封印，\n则将火苗最大上限限制为 1000+500m。m=n时上限恢复至1w。\n且解除封印瞬间，立即把当前火苗扣减到新的上限\n已封印时，每15s返回3×3范围内卡片耗能的50%。\n全体黄色龙柱处于封印状态时，火苗上限增加额外容量为15000")
	register_enemy_info_island("aoman_longzhu", "傲慢龙柱:未封印时，周期性将 3×3 范围内的攻击类卡片感染为青苹果。\n青苹果生命值200w,免疫爆炸、冲撞、吞噬，可被碾压，出现40s后消失，\n所在格子无法放卡，老鼠可以消耗苹果恢复生命1w点\n已封印时，发射3×3 范围内攻击类卡片数量的红苹果追踪弹，\n追踪场上最近敌人，命中后造成2000点伤害并消失。")
    // 跨服远征感染敌人情报岛信息
    register_enemy_info_island("infected_normal_mouse", "平民僵尸鼠：被感染的普通老鼠,无特殊能力。");
    register_enemy_info_island("infected_football_fan_mouse", "球迷僵尸鼠：被感染的球迷鼠,生命值稍高。");
    register_enemy_info_island("infected_iron_pan_mouse", "铁锅僵尸鼠：被感染的铁锅鼠,生命值较高。");
    register_enemy_info_island("infected_skateboard_mouse", "滑板僵尸鼠：被感染的滑板鼠,速度快且能跳过卡片。");
    register_enemy_info_island("infected_landlady_mouse", "房东僵尸鼠：被感染的房东鼠,能抵挡直射子弹。");
    register_enemy_info_island("infected_kangaroo", "跳跳僵尸鼠：被感染的跳跳鼠,能连续跳过卡片。");
    register_enemy_info_island("infected_roller_skating_mouse", "轮滑僵尸鼠：被感染的轮滑鼠,生命值极高且速度快。");
    register_enemy_info_island("infected_giant_mouse", "巨型僵尸鼠：被感染的巨人鼠,生命值和伤害极高。");
    register_enemy_info_island("infected_panda_mouse", "熊猫僵尸鼠：被感染的熊猫鼠,会投出小熊猫僵尸鼠。\n生命值降低至一半时,如果自身在第五列之外\n则会向第3或4列投掷一只生命值为100的小熊猫鼠。");
    register_enemy_info_island("infected_little_panda_mouse", "小熊猫僵尸鼠：由熊猫僵尸鼠投掷出的小熊猫僵尸鼠。");
    register_enemy_info_island("infected_paper_boat_mouse", "纸船僵尸鼠：被感染的纸船鼠,无特殊能力。");
    register_enemy_info_island("infected_duck_mouse", "鸭子泳圈僵尸鼠：被感染的鸭子泳圈鼠,生命值稍高。");
    register_enemy_info_island("infected_tropical_fish_mouse", "热带鱼泳圈僵尸鼠：被感染的热带鱼泳圈鼠,生命值较高。");
    register_enemy_info_island("infected_diver_mouse", "潜水僵尸鼠：被感染的潜水鼠,不攻击时潜在水面下。");
    register_enemy_info_island("infected_frog_prince_mouse", "青蛙王子僵尸鼠：被感染的青蛙王子鼠,可越过障碍。");
    register_enemy_info_island("infected_submarine_mouse", "水潜艇僵尸鼠：被僵尸鼠操控的水潜艇,装甲完整且不攻击时潜水。");
    register_enemy_info_island("infected_mario_mouse", "变异洞君：被感染后变得更加强大的洞君。\n洞君会在地图右侧出场,并使用下列技能的随机一个,随后消失。\n技能1：洞君会在地图第9列挖掘一个坑洞\n并在4-7列的范围内随机生成三个生命值为600的管道\n进入坑洞的老鼠会被传送到管道处。\n技能2：洞君会进行3次跳跃,依次摧毁本行第8、6、4列的三张卡片。");
    register_enemy_info_island("infected_arno", "变异阿诺：被感染后变得更加强大的阿诺。\n阿诺会在地图右侧出场,并使用下列技能的随机一个,随后消失。\n技能1：阿诺发射两颗子弹,摧毁本行最左侧的两张卡片。\n技能2：阿诺在较长前摇后冲刺,摧毁本行右侧7列的卡片。");
    register_enemy_info_island("infected_fire_residue", "感染火渣：被感染的火渣,掌控火焰之力。");
    register_enemy_info_island("infected_zhanshen", "变异战神：被感染后变得更加强大的战神。\n战神会在第4行出场,出场时会同时在第2行和第6行分别生成一个\n生命值为150000的木鸭,木鸭每隔30秒会发射一个木轮,摧毁本行卡片。\n战神会持续向左侧移动,每隔18秒会停止,并使用一次技能。\n技能1：战神在本行左侧一格和本列上下两行中分别召唤一个生命值为1000的战士鼠。\n技能2：战神在召唤战士鼠的基础上,还会释放一个生命值为1800的滚木\n滚木会摧毁三行内的卡片。\n战神会使用1-2的技能循环。");

    // 融合卡
    register_card_info_island("lizi_god", "\n来源:诸神宝殿\n[投掷类][灼烧投手]\n基础能力：向前方喷出可以持续灼烧老鼠的滚烫栗子。持续造成10次[攻击力]点伤害。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n初级融合：伤害提高扩大到3×3范围。\n\n深度融合：间隔一段时间,额外产生一次3×3爆炸。\n\n灵魂融合：向前方3行投掷栗子子弹。");
    register_card_info_island("youyu_god", "\n来源:诸神宝殿\n[多向类][类海星类]\n基础能力：向8个方向分别发射2发子弹。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n初级融合：无需底座即可独立部署。\n\n深度融合：前后两路各增加1发子弹,并且中路子弹可以过火。\n\n灵魂融合：向前增加2路子弹,共计22发。");
    register_card_info_island("ronghehaixing", "\n来源:诸神宝殿\n[多向类][海星类]\n基础能力：同时向5个方向射出星星子弹,可直接在海底生存。\n子弹可被水神反弹并提升伤害,能携带上岸攻击。\n *星级影响[攻击力],技能影响[攻击间隔]。\n\n初级融合：向后的子弹数量增加一发。\n\n深度融合：攻击附加单格溅射。\n\n灵魂融合：斜向子弹触碰上下边框后,变为追踪子弹。");
    register_card_info_island("ronghedan_god", "\n来源:诸神宝殿\n[投掷类][单线投手]\n基础能力：投掷强力鸡蛋的同时会产生溅射。\n命中敌人造成[攻击力]点伤害,并对周围3×3范围敌人造成35%溅射伤害。\n *星级影响[攻击力]、[定身概率]、[定身时间],技能影响[攻击间隔]。\n\n初级融合：攻击命中后有一定几率产生定身效果。\n\n深度融合：溅射范围额外附加毒气伤害。\n\n灵魂融合：可向前方3行投掷子弹。");
    register_card_info_island("ronghehuopen", "\n来源:诸神宝殿\n[增幅类][子弹增幅][平射增幅]\n基础能力：穿过它的弹药提高伤害，倍率为[攻击力]。冰弹无效。\n *星级影响[攻击力],技能影响[生命值]。\n\n初级融合：啃咬反伤，啃咬它的老鼠受到等量伤害。\n\n深度融合：每隔一段时间，在周围5*5范围内召唤寒冰之气攻击鼠军。\n\n灵魂融合：子弹变为冰弹，伤害提高。");
    register_card_info_island("ronghesanxian", "\n来源:诸神宝殿\n[直射类][三线类]\n基础能力：可以同时攻击前方三条线，每行发射2发葡萄酒弹。\n *星级影响[攻击力]，技能影响[攻击速度]。\n\n初级融合：老鼠被击中后额外附加燃烧buff。\n\n深度融合：每行增加1发子弹。\n\n灵魂融合：每行3发子弹，且子弹可穿透老鼠和障碍。");
    register_card_info_island("shuanggu", "\n来源:商城\n[专业防空类][陆空兼备类]\n基础能力：同时向前方发射2发对陆子弹和2发对空子弹。\n *星级影响[攻击力]，技能影响[攻击速度]。\n\n一转能力：增加1发对空子弹。\n\n二转能力：增加1发对陆子弹。");
    register_card_info_island("rongheshuanggu", "\n来源:诸神宝殿\n[专业防空类][陆空兼备类]\n基础能力：同时向前发射4发对陆子弹和4发对空子弹。\n *星级影响[攻击力]，技能影响[攻击速度]。\n\n初级融合：对空对地子弹分别+1。\n\n深度融合：对地子弹变为穿透。\n\n灵魂融合：对空子弹变为全屏追踪。");
    register_card_info_island("ronghedapao", "\n来源:诸神宝殿\n[灰烬类][轰炸类]\n基础能力：每隔[攻击间隔]秒，向本行第八列投下2枚巧克力炸弹。\n秒杀3*3范围内非防爆老鼠，防爆鼠受到[攻击力]点伤害。\n *星级影响[攻击间隔]，技能影响[冷却时间]。\n\n初级融合：无需底座，卡牌冷却时间减半。\n\n深度融合：爆炸范围扩大至3*5。\n\n灵魂融合：耗能减少75，爆炸属性改为碾压。");
    register_card_info_island("ronghekafei", "\n来源:诸神宝殿\n[直射类][传统直线类]\n基础能力：当前方一行内出现敌人时，每隔[攻击间隔]秒\n就会向前方连续发射3发伤害为[攻击力]的咖啡弹。\n不需要火苗就能使用，白天不会睡觉。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n初级融合：向前方连续发射3发咖啡弹。\n\n深度融合：子弹变为1发穿透弹。\n\n灵魂融合：放置时会同时在1格内放置3个咖啡杯");
    register_card_info_island("wuxingshe", "\n来源:跨服商店\n[增幅类][五向增幅]\n基础能力：汇聚了灵蛇能力的神奇法阵,可为范围内5方向卡片增加攻击力。\n倍率为[攻击力]/100，同类增幅取最高，不叠加。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：攻击力提升。\n\n二转能力：攻击大幅提升，范围扩大。");
}
